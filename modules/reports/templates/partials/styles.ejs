<style>
  body {
    margin: 0;
    padding: 0;
    background: #f3f4f6;
    color: #111827;
    font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 13px;
    line-height: 1.6;
  }

  .report-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 28px;
    background: #ffffff;
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
    border-radius: 18px;
  }

  .report-header {
    border-bottom: 2px solid #e2e8f0;
    margin-bottom: 26px;
    padding-bottom: 16px;
  }

  h1, h2, h3 {
    margin: 0;
    color: #0f172a;
  }

  h1 {
    font-size: 32px;
    letter-spacing: -0.03em;
  }

  h2 {
    color: #1d4ed8;
    font-size: 18px;
    margin-top: 26px;
    margin-bottom: 12px;
  }

  h3 {
    font-size: 14px;
    margin-bottom: 8px;
  }

  .muted {
    color: #475569;
  }

  .report-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 10px;
    color: #475569;
    font-size: 12px;
  }

  .report-meta span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .summary-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin-top: 18px;
  }

  .summary-card {
    padding: 16px;
    border-radius: 14px;
    background: #eff6ff;
    border: 1px solid #dbeafe;
  }

  .summary-card strong {
    display: block;
    margin-top: 8px;
    font-size: 20px;
    color: #0f172a;
  }

  .report-section {
    margin-top: 28px;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
    table-layout: fixed;
    word-wrap: break-word;
  }

  th, td {
    border: 1px solid #e2e8f0;
    padding: 12px 14px;
    vertical-align: top;
  }

  th {
    background: #eff6ff;
    color: #1e3a8a;
    font-weight: 700;
    text-align: left;
  }

  tbody tr:nth-child(odd) {
    background: #fbfbfc;
  }

  tbody tr:hover {
    background: #f8fafc;
  }

  .pill {
    border-radius: 999px;
    display: inline-flex;
    font-size: 10px;
    font-weight: 700;
    padding: 4px 8px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .critical, .failure, .high {
    background: #fee2e2;
    color: #b91c1c;
  }

  .warning, .medium, .investigating, .pending {
    background: #fef3c7;
    color: #92400e;
  }

  .info, .low, .success, .resolved, .closed {
    background: #dcfce7;
    color: #166534;
  }

  .section-note {
    font-size: 12px;
    color: #475569;
    margin-top: 6px;
  }

  .page-break {
    page-break-before: always;
  }

  .report-footer {
    margin-top: 34px;
    padding-top: 18px;
    border-top: 1px solid #e2e8f0;
    color: #64748b;
    font-size: 11px;
  }

  @media print {
    .report-container {
      box-shadow: none;
      border-radius: 0;
      margin: 0;
      padding: 16px;
    }

    .report-footer {
      page-break-inside: avoid;
    }

    table, th, td {
      page-break-inside: avoid;
    }
  }
</style>
