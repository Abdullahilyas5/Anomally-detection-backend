<style>
  body { color: #152238; font-family: Arial, Helvetica, sans-serif; font-size: 12px; line-height: 1.45; margin: 0; }
  .report-header { border-bottom: 2px solid #172554; margin-bottom: 20px; padding-bottom: 14px; }
  h1, h2, h3 { margin: 0; }
  h1 { color: #172554; font-size: 28px; }
  h2 { color: #1e3a8a; font-size: 16px; margin: 20px 0 10px; }
  h3 { font-size: 13px; margin-bottom: 8px; }
  .muted { color: #64748b; }
  .kpi-grid { display: grid; gap: 10px; grid-template-columns: repeat(4, 1fr); margin: 16px 0; }
  .kpi { border: 1px solid #cbd5e1; border-radius: 6px; padding: 10px; }
  .kpi strong { display: block; font-size: 22px; }
  table { border-collapse: collapse; margin-top: 8px; width: 100%; }
  th, td { border: 1px solid #dbe4ef; padding: 7px; text-align: left; vertical-align: top; }
  th { background: #eaf1fb; color: #172554; }
  .pill { border-radius: 999px; display: inline-block; font-size: 10px; font-weight: 700; padding: 2px 7px; text-transform: uppercase; }
  .critical, .failure, .high { background: #fee2e2; color: #991b1b; }
  .warning, .medium, .investigating, .pending { background: #fef3c7; color: #92400e; }
  .info, .low, .success, .resolved, .closed { background: #dcfce7; color: #166534; }
  .page-break { page-break-before: always; }
</style>
