<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <%- await include('partials/styles') %>
</head>
<body>
  <div class="report-container">
    <%- await include('partials/header', { meta, helpers }) %>

    <div class="report-meta">
      <span><strong>Report Type:</strong> <%= helpers.title(meta.type) %></span>
      <span><strong>Requested By:</strong> <%= meta.requestedBy?.name || meta.requestedBy?.email || 'System' %></span>
      <span><strong>Period:</strong> <%= meta.periodLabel %></span>
    </div>

    <section class="report-section">
      <%- await include('partials/kpis', { kpis, helpers }) %>
    </section>

    <section class="report-section">
      <h2>Severity Breakdown</h2>
      <table>
        <thead>
          <tr>
            <th>Severity</th>
            <th>Count</th>
          </tr>
        </thead>
        <tbody>
          <% severityBreakdown.forEach((row) => { %>
            <tr>
              <td><span class="pill <%= row.severity %>"><%= helpers.title(row.severity) %></span></td>
              <td><strong><%= helpers.number(row.count) %></strong></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </section>

    <section class="report-section">
      <h2>Detection Trends</h2>
      <table>
        <thead>
          <tr>
            <th>Date</th>
            <th>Detections</th>
          </tr>
        </thead>
        <tbody>
          <% trends.forEach((row) => { %>
            <tr>
              <td><%= row.date %></td>
              <td><strong><%= helpers.number(row.count) %></strong></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </section>

    <section class="report-section">
      <h2>Top Affected Systems</h2>
      <table>
        <thead>
          <tr>
            <th>Procurement</th>
            <th>Evidence</th>
            <th>Anomalies Count</th>
          </tr>
        </thead>
        <tbody>
          <% topAffectedSystems.forEach((row) => { %>
            <tr>
              <td><strong><%= row.procurement ? row.procurement.title : `Procurement #${row.procurement_id}` %></strong></td>
              <td class="muted"><%= row.procurement ? row.procurement.file_name : 'N/A' %></td>
              <td><span class="pill critical"><%= helpers.number(row.count) %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </section>

    <section class="report-section">
      <h2>Recommendations</h2>
      <div class="summary-card" style="background: #eff6ff; border-left: 4px solid #2563eb; padding: 18px;">
        <ul style="margin: 0; padding-left: 18px; color: #1e3a8a; font-size: 12px;">
          <% recommendations.forEach((item) => { %>
            <li style="margin-bottom: 6px;"><%= item %></li>
          <% }) %>
        </ul>
      </div>
    </section>

    <div class="page-break"></div>

    <section class="report-section">
      <h2>Complete Anomalies Overview</h2>
      <p class="section-note">This complete anomalies table includes all detected issues, their status, and investigation notes for audit review.</p>
      <table>
        <thead>
          <tr>
            <th style="width: 8%;">ID</th>
            <th style="width: 26%;">Title & Description</th>
            <th style="width: 16%;">Timestamp</th>
            <th style="width: 14%;">Severity</th>
            <th style="width: 14%;">Status</th>
            <th style="width: 22%;">Investigation Notes</th>
          </tr>
        </thead>
        <tbody>
          <% anomalies.forEach((item) => { %>
            <tr>
              <td><strong>#<%= item.id %></strong></td>
              <td>
                <strong><%= item.title %></strong>
                <div class="muted" style="margin-top: 6px;"><%= item.description || 'No description provided.' %></div>
              </td>
              <td><%= helpers.formatDate(item.createdAt) %></td>
              <td><span class="pill <%= item.severity %>"><%= helpers.title(item.severity) %></span></td>
              <td><span class="pill <%= item.status %>"><%= helpers.title(item.status) %></span></td>
              <td style="font-size: 12px;"><%= item.investigation_notes || 'No notes recorded.' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </section>

    <div class="report-footer">
      Generated by the Audit Reports service. Review all items and follow up on high-priority anomalies.
    </div>
  </div>
</body>
</html>
