<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <%- include('partials/styles') %>
</head>
<body>
  <%- include('partials/header', { meta, helpers }) %>
  <%- include('partials/kpis', { kpis, helpers }) %>

  <h2>Historical Records</h2>
  <table>
    <thead><tr><th>ID</th><th>Procurement</th><th>Status</th><th>Severity</th><th>Created</th><th>Updated</th></tr></thead>
    <tbody>
      <% anomalies.forEach((item) => { %>
        <tr>
          <td><%= item.id %></td>
          <td><%= item.procurement ? item.procurement.title : 'N/A' %></td>
          <td><span class="pill <%= item.status %>"><%= helpers.title(item.status) %></span></td>
          <td><span class="pill <%= item.severity %>"><%= helpers.title(item.severity) %></span></td>
          <td><%= helpers.formatDate(item.createdAt) %></td>
          <td><%= helpers.formatDate(item.updatedAt) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <h2>Resolution Timeline</h2>
  <table>
    <thead><tr><th>Flag</th><th>Procurement</th><th>Status</th><th>Resolution Notes</th><th>Updated</th></tr></thead>
    <tbody>
      <% flags.forEach((flag) => { %>
        <tr>
          <td>#<%= flag.id %> <%= helpers.title(flag.flag_type) %></td>
          <td><%= flag.procurement ? flag.procurement.title : 'N/A' %></td>
          <td><span class="pill <%= flag.status %>"><%= helpers.title(flag.status) %></span></td>
          <td><%= flag.resolution_notes || 'N/A' %></td>
          <td><%= helpers.formatDate(flag.updatedAt) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <h2>User Activity</h2>
  <table>
    <thead><tr><th>User</th><th>Action</th><th>Status</th><th>Severity</th><th>Timestamp</th></tr></thead>
    <tbody>
      <% logs.forEach((log) => { %>
        <tr>
          <td><%= log.user ? `${log.user.name} (${log.user.email})` : 'System' %></td>
          <td><%= log.action %></td>
          <td><span class="pill <%= log.status %>"><%= helpers.title(log.status) %></span></td>
          <td><span class="pill <%= log.severity %>"><%= helpers.title(log.severity) %></span></td>
          <td><%= helpers.formatDate(log.createdAt) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</body>
</html>
