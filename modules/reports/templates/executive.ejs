<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <%- include('partials/styles') %>
</head>
<body>
  <%- include('partials/header', { meta, helpers }) %>
  <%- include('partials/kpis', { kpis, helpers }) %>

  <h2>Business Impact</h2>
  <table>
    <tbody>
      <tr><th>Risk Level</th><td><%= kpis.businessImpact %></td></tr>
      <tr><th>Pending Flags</th><td><%= helpers.number(kpis.pendingFlags) %></td></tr>
      <tr><th>Failed Operations</th><td><%= helpers.number(kpis.failedLogs) %></td></tr>
      <tr><th>Total Procurements</th><td><%= helpers.number(kpis.totalProcurements) %></td></tr>
    </tbody>
  </table>

  <h2>Recommendations</h2>
  <ul>
    <% recommendations.forEach((item) => { %>
      <li><%= item %></li>
    <% }) %>
  </ul>

  <h2>Trend Snapshot</h2>
  <table>
    <thead><tr><th>Date</th><th>Detections</th></tr></thead>
    <tbody>
      <% trends.slice(-10).forEach((row) => { %>
        <tr><td><%= row.date %></td><td><%= helpers.number(row.count) %></td></tr>
      <% }) %>
    </tbody>
  </table>
</body>
</html>
